@startuml state_diagram
!theme plain
title Card State Diagram

skinparam backgroundColor #FEFEFE

[*] --> Blank : Thẻ trắng

Blank --> Initialized : INS_INIT_CARD\n(Admin đăng ký)

state Initialized {
    [*] --> DefaultPIN
    DefaultPIN : PIN = 000000
    DefaultPIN : isDefaultPin = true
    
    DefaultPIN --> PINChanged : User đổi PIN\nlần đầu đăng nhập
    
    PINChanged : isDefaultPin = false
    PINChanged : PIN do user chọn
}

state "Authenticated" as Auth {
    [*] --> Unlocked
    Unlocked : MasterKey loaded
    Unlocked : Có thể đọc/ghi data
    
    Unlocked --> [*] : Deselect Applet\n(MK cleared)
}

Initialized --> Auth : INS_VERIFY_PIN\n(PIN đúng)
Auth --> Initialized : Card deselected

state "Blocked" as Block {
    Block : triesRemaining = 0
    Block : Không thể verify PIN
}

Initialized --> Block : 3 lần sai PIN
Block --> Initialized : INS_UNLOCK\n(Admin PIN)

@enduml


@startuml apdu_commands
!theme plain
title APDU Commands Reference

skinparam backgroundColor #FEFEFE

object "INS_INIT_CARD (0x10)" as init {
    CLA = 0x80
    INS = 0x10
    P1 = 0x00
    P2 = 0x00
    Data = [idLen | CardID | UserPIN | AdminPIN]
    Response = 0x9000
}

object "INS_VERIFY_PIN (0x20)" as verify {
    CLA = 0x80
    INS = 0x20
    P1 = 0x00
    P2 = 0x00
    Data = [PIN 6 bytes]
    Response = 0x9000 | 0x63CX
}

object "INS_CHANGE_PIN (0x21)" as change {
    CLA = 0x80
    INS = 0x21
    P1 = 0x00
    P2 = 0x00
    Data = [oldPIN | newPIN]
    Response = 0x9000
}

object "INS_WRITE_PERSONAL (0x30)" as write {
    CLA = 0x80
    INS = 0x30
    P1 = 0x00
    P2 = 0x00
    Data = [fieldId | data]
    Response = 0x9000
}

object "INS_READ_PERSONAL (0x31)" as read {
    CLA = 0x80
    INS = 0x31
    P1 = 0x00
    P2 = 0x00
    Data = [fieldId]
    Response = [decrypted data]
}

object "INS_SIGN_CHALLENGE (0x41)" as sign {
    CLA = 0x80
    INS = 0x41
    P1 = 0x00
    P2 = 0x00
    Data = [challenge 32 bytes]
    Response = [signature 128 bytes]
}

@enduml
